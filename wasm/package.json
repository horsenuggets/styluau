{
  "name": "styluau",
  "description": "A code formatter for Luau",
  "version": "2.6.0",
  "license": "MPL-2.0",
  "readme": "README.md",
  "scripts": {
    "test": "node --test tests/smoke.test.mjs tests/smoke.test.cjs"
  },
  "files": [
    "styluau_lib_*",
    "styluau_lib.*",
    "*.md"
  ],
  "type": "module",
  "main": "styluau_lib_node.cjs",
  "module": "styluau_lib.js",
  "types": "styluau_lib.d.ts",
  "exports": {
    ".": {
      "types": "./styluau_lib.d.ts",
      "webpack": "./styluau_lib.js",
      "node": {
        "module-sync": "./styluau_lib_node.mjs",
        "require": "./styluau_lib_node.cjs",
        "default": "./styluau_lib_node.mjs"
      },
      "deno": "./styluau_lib_deno.js",
      "bun": "./styluau_lib_node.mjs",
      "default": "./styluau_lib.js"
    },
    "./web": {
      "types": "./styluau_lib_web.d.ts",
      "default": "./styluau_lib_web.js"
    },
    "./styluau_lib_bg.wasm": "./styluau_lib_bg.wasm",
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "sideEffects": [
    "./styluau_lib.js",
    "./styluau_lib_node.mjs",
    "./styluau_lib_node.cjs",
    "./styluau_lib_deno.js"
  ],
  "keywords": [
    "cli",
    "utility",
    "lua",
    "lua51",
    "formatter"
  ]
}
